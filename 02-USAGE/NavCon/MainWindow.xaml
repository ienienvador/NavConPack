<Window x:Class="NavCon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NavCon Keyboard Mapper v3.6.0"
        Width="600" Height="500" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock x:Name="TbStatus" Text="Initialisation..." Foreground="#CCCCCC"
                       FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status area -->
            <Border Grid.Column="0" Background="#1E1E1E" Padding="10" CornerRadius="5" Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TbMapping" Text="[idle]" Foreground="#00FF00"
                               FontFamily="Consolas" FontSize="12"/>
                </ScrollViewer>
            </Border>

            <!-- Preset panel -->
            <Border Grid.Column="1" Background="#2D2D30" Padding="10" CornerRadius="5" Width="200">
                <StackPanel>
                    <TextBlock Text="Presets" Foreground="#CCCCCC" FontWeight="Bold"
                               FontSize="13" Margin="0,0,0,8"/>
                    <ListBox x:Name="LbPresets" Background="#1E1E1E" Foreground="White"
                             BorderThickness="0" Height="200" SelectionMode="Single"/>
                    <Button x:Name="BtnLoadPreset" Content="Charger" Margin="0,8,0,0"
                            Padding="5,3" Click="BtnLoadPreset_Click"/>
                    <Button x:Name="BtnConfig" Content="Configurer" Margin="0,4,0,0"
                            Padding="5,3" Click="BtnConfig_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Info bar -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="8" CornerRadius="5" Margin="0,8,0,0">
            <TextBlock x:Name="TbInfo" Text="" Foreground="#888888" FontFamily="Consolas" FontSize="11"/>
        </Border>

        <!-- Bottom bar -->
        <Border Grid.Row="3" Background="#2D2D30" Padding="10" CornerRadius="5" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TbSlot" Text="Slot: --" Foreground="#888888"
                           VerticalAlignment="Center" FontFamily="Consolas"/>
                <Button Grid.Column="1" x:Name="BtnStart" Content="Démarrer"
                        Width="120" Height="30" FontSize="14" FontWeight="Bold"
                        Click="BtnStart_Click"/>
                <TextBlock Grid.Column="2" x:Name="TbHidHide" Text="" Foreground="#888888"
                           VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>
</Window>
