<Window x:Class="NavCon.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration NavCon" Width="700" Height="550"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="TabControl">
            <TabItem Header="Boutons">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel x:Name="SpButtons"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Trigger L2">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock Text="Seuil de declenchement du trigger analogique L2"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Seuil (0-255):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" x:Name="SliderThreshold" Minimum="0" Maximum="255"
                                TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderThreshold_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TbThreshValue" Text="80" MinWidth="30"
                                   TextAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Touche assignee au trigger L2"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="L2 (Trigger gauche):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="CbL2Key"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Stick Analogique">
                <StackPanel Margin="20">
                    <TextBlock Text="Deadzone du stick" FontSize="13" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Deadzone (0-32767):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" x:Name="SliderDeadzone" Minimum="0" Maximum="32767"
                                TickFrequency="500" IsSnapToTickEnabled="True" ValueChanged="SliderDeadzone_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TbDzValue" Text="7849" MinWidth="50"
                                   TextAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Touches du stick (WASD par defaut)"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Haut (W):" Margin="0,5"/>
                            <TextBlock Text="Bas (S):" Margin="0,5"/>
                            <TextBlock Text="Gauche (A):" Margin="0,5"/>
                            <TextBlock Text="Droite (D):" Margin="0,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="CbStickUp" Margin="0,2" Width="120" HorizontalAlignment="Left"/>
                            <ComboBox x:Name="CbStickDown" Margin="0,2" Width="120" HorizontalAlignment="Left"/>
                            <ComboBox x:Name="CbStickLeft" Margin="0,2" Width="120" HorizontalAlignment="Left"/>
                            <ComboBox x:Name="CbStickRight" Margin="0,2" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Presets">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock Text="Charger un profil preconfigure"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="CbPresets" MinWidth="200" HorizontalAlignment="Left"/>
                        <Button Grid.Column="1" Content="Charger" Margin="10,0,0,0" Padding="10,3" Click="BtnLoadPreset2_Click"/>
                    </Grid>

                    <Border Background="#1E1E1E" Padding="10" CornerRadius="5">
                        <TextBlock x:Name="TbPresetInfo" Text="Selectionnez un preset" Foreground="#888888"
                                   FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Test en direct">
                <StackPanel Margin="20">
                    <TextBlock Text="Appuyez sur les boutons du controleur pour voir les touches envoyees"
                               FontSize="11" FontStyle="Italic" Margin="0,0,0,10"/>
                    <Button x:Name="BtnTestToggle" Content="Demarrer le test" Width="140" Height="28"
                            Margin="0,0,0,10" Click="BtnTestToggle_Click"/>
                    <Border Background="#1E1E1E" CornerRadius="5" Height="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TbTestOutput" FontFamily="Consolas" FontSize="11"
                                       Foreground="#00FF00" Padding="5" Text="En attente..."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Bottom bar -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="10" CornerRadius="5" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Config sauvegardee dans config.json"
                           Foreground="Gray" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reinitialiser" Margin="0,0,8,0" Padding="10,3" Click="BtnReset_Click"/>
                    <Button Content="Sauvegarder" Padding="10,3" FontWeight="Bold" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
